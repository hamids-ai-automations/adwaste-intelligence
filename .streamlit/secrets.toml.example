# ---------------------------------------------------------------------------
# AdWaste Intelligence — Streamlit secrets template
#
# Copy this file to .streamlit/secrets.toml and populate only what you need:
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is git-ignored. Never commit real credentials.
# On Streamlit Community Cloud, paste these values in App Settings -> Secrets.
#
# Both keys are OPTIONAL — the application works 100% offline/free without them.
# ---------------------------------------------------------------------------

# Optional Google Gemini API key for the BYOK AI Intent Audit in Tab 3.
# Users can also paste a key at runtime (held in memory only, never persisted).
GEMINI_API_KEY = ""

# Optional live Chrome Web Store URL for the Google Ads Waste Detector extension.
# Leave empty to display the "launching soon" companion card in the sidebar.
CHROME_EXTENSION_URL = ""
